# Modelo de variáveis.
# - Desenvolvimento: copie para .env (DATABASE_URL aponta para o Postgres embutido, porta 54329).
# - Servidor: crie .env.deploy, copie para .env e rode chmod 600 .env .env.deploy.
# Nunca crie .env.production: o Next carrega esse arquivo sozinho e ele vaza para a imagem.

# Postgres (usado pelo docker-compose). Senha só com letras e números: openssl rand -hex 24
POSTGRES_USER=news
POSTGRES_PASSWORD=troqueEstaSenha123
POSTGRES_DB=news

# Só em desenvolvimento (no compose a URL é montada a partir das variáveis acima).
DATABASE_URL=postgresql://news:devpass123@localhost:54329/news

# Site
SITE_URL=https://news.neojr.com
CONTACT_EMAIL=contato@neojr.com

# Doação (/doar). Opcionais e lidas em runtime: sem Pix nem PayPal, o botão de doação some.
# A chave Pix fica legível para quem ler o QR: use chave aleatória (EVP), nunca CPF ou telefone.
# PIX_KEY_TYPE: RANDOM | EMAIL | PHONE | CPF | CNPJ (padrão: RANDOM)
PIX_KEY_TYPE=RANDOM
PIX_KEY=
# Nome e cidade do recebedor (máx. 25 e 15 caracteres; acentos são removidos)
PIX_NAME=
PIX_CITY=
# Opcional, máx. 25 caracteres
PIX_DESCRIPTION=neojr news
# Link do PayPal Donate ou PayPal.me
PAYPAL_DONATE_URL=

# Worker
WORKER_INTERVAL_MINUTES=20
WORKER_CONCURRENCY=3
RETENTION_DAYS=90
